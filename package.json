{
  "name": "vscode-variables",
  "version": "1.0.1",
  "description": "Replace VSCode predefined variables for extensions",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepack": "npm run build",
    "test:types": "npm run build && tsc --noEmit --strict --esModuleInterop --module Node16 --moduleResolution Node16 tests/types.cts tests/types.mts",
    "test:package": "node scripts/test-package.cjs"
  },
  "files": [
    "package.json",
    "package-lock.json",
    "README.md",
    "LICENSE.md",
    "dist"
  ],
  "main": "dist/index.js",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.95.0",
    "coc.nvim": "^0.0.83-next.27",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "author": "Dominic Vonk",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/DominicVonk/vscode-variables.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/DominicVonk/vscode-variables/issues"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./coc": {
      "types": "./dist/coc.d.ts",
      "default": "./dist/coc.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "coc": [
        "dist/coc.d.ts"
      ]
    }
  }
}
